# ==========================================
# Variáveis de Ambiente (Configurações)
# ==========================================

# Credenciais do Banco de Dados PostgreSQL (Preenchido para ambiente local)
DB_USER=postgres
DB_PASS=postgres

# Credenciais do Painel pgAdmin (Preenchido para ambiente local)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASS=admin

# ==========================================
# Configurações do Módulo de Inteligência Artificial
# ==========================================
# Provedor da IA (Opções: Gemini, ChatGPT, Groq)
# Se deixar em branco, o padrão será Gemini.
AI_PROVIDER=Gemini

# 1. Google Gemini (Padrão)
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq (Llama 3 ultra-rápido)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: Altere o modelo do Groq (Ex: llama3-70b-8192, mixtral-8x7b-32768)
# GROQ_MODEL=llama3-8b-8192

# 3. OpenAI (ChatGPT)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

